rules_version = '2';

// Reglas de seguridad de Firestore para el calendario de JM Argentina.
// Copiá todo este archivo en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{db}/documents {

    function ingresado() { return request.auth != null; }
    function rolDoc() { return /databases/$(db)/documents/roles/$(request.auth.uid); }
    function tieneRol() { return ingresado() && exists(rolDoc()); }
    function esAdmin() { return tieneRol() && get(rolDoc()).data.rol == 'admin'; }
    function esJefe() { return tieneRol() && get(rolDoc()).data.rol in ['jefe', 'admin']; }

    function texto(v, max) { return v is string && v.size() <= max; }
    function eventoValido(d) {
      return d.keys().hasOnly(['titulo', 'fecha', 'fechaFin', 'hora', 'lugar', 'rama', 'tipo', 'descripcion',
                               'costo', 'link', 'info', 'thumb', 'tieneFlyer', 'autorUid', 'autorNombre',
                               'creado', 'actualizado'])
        && texto(d.titulo, 120) && d.titulo.size() > 0
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && texto(d.rama, 120)
        && d.tipo in ['Nacional', 'Regional', 'Rama']
        && texto(d.descripcion, 2000) && d.descripcion.size() > 0
        && (!('thumb' in d) || texto(d.thumb, 80000));
    }

    // Cualquiera que ingresó guarda su nombre y correo (así el admin puede habilitarlo como jefe).
    match /usuarios/{uid} {
      allow read: if esAdmin() || (ingresado() && request.auth.uid == uid);
      allow create, update: if ingresado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'foto', 'ultimoIngreso']);
      allow delete: if esAdmin();
    }

    // Roles: cada uno lee el suyo; solo un admin asigna o quita roles.
    // El primer admin se crea a mano desde la consola (ver FIREBASE.md).
    match /roles/{uid} {
      allow read: if esAdmin() || (ingresado() && request.auth.uid == uid);
      allow write: if esAdmin();
    }

    // Eventos: los ve todo el mundo. Publican jefes y admins; cada jefe edita o borra los suyos.
    match /eventos/{id} {
      allow read: if true;
      allow create: if esJefe()
        && request.resource.data.autorUid == request.auth.uid
        && eventoValido(request.resource.data);
      allow update: if (esAdmin() || (esJefe() && resource.data.autorUid == request.auth.uid))
        && request.resource.data.autorUid == resource.data.autorUid
        && eventoValido(request.resource.data);
      allow delete: if esAdmin() || (esJefe() && resource.data.autorUid == request.auth.uid);
    }

    // Flyers en tamaño completo (separados para que la lista de eventos cargue rápido).
    match /flyers/{id} {
      allow read: if true;
      allow create, update: if (esAdmin() || (esJefe() && getAfter(/databases/$(db)/documents/eventos/$(id)).data.autorUid == request.auth.uid))
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if esAdmin() || (esJefe() && get(/databases/$(db)/documents/eventos/$(id)).data.autorUid == request.auth.uid);
    }

    // Fichas de las ramas: las ve todo el mundo. Solo las completan el admin y los jefes
    // de ESA rama (la rama asignada en roles/{uid} tiene que coincidir con el nombre de la ficha).
    function ramaPropia() { return get(rolDoc()).data.rama; }
    function puedeFicha(nombre) { return esAdmin() || (esJefe() && ramaPropia() == nombre); }
    function fichaValida(d) {
      return d.keys().hasOnly(['nombre', 'descripcion', 'jefe', 'instagram', 'encuentros', 'gruposDeVida',
                               'actividades', 'video', 'contacto', 'cantidadFotos', 'actualizado', 'actualizadoPor'])
        && texto(d.nombre, 120) && d.nombre.size() > 0
        && (!('descripcion' in d) || texto(d.descripcion, 3000))
        && (!('encuentros' in d) || texto(d.encuentros, 500))
        && (!('instagram' in d) || texto(d.instagram, 200))
        && (!('video' in d) || texto(d.video, 400))
        && (!('contacto' in d) || texto(d.contacto, 300))
        && (!('actividades' in d) || (d.actividades is list && d.actividades.size() <= 20))
        && (!('jefe' in d) || d.jefe is map);
    }
    match /fichas_ramas/{id} {
      allow read: if true;
      allow create: if puedeFicha(request.resource.data.nombre) && fichaValida(request.resource.data);
      allow update: if puedeFicha(resource.data.nombre) && request.resource.data.nombre == resource.data.nombre
        && fichaValida(request.resource.data);
      allow delete: if esAdmin();
    }
    match /fichas_fotos/{id} {
      allow read: if true;
      allow create, update: if puedeFicha(getAfter(/databases/$(db)/documents/fichas_ramas/$(id)).data.nombre)
        && request.resource.data.nombre == getAfter(/databases/$(db)/documents/fichas_ramas/$(id)).data.nombre
        && request.resource.data.fotos is list && request.resource.data.fotos.size() <= 6;
      allow delete: if esAdmin();
    }

    // Pedidos de los formularios del sitio (proponer hito, solicitar acceso, proponer material).
    // Los crea cualquiera que ingresó con Google, a su nombre; solo el admin los lee y gestiona.
    function pedidoValido(d) {
      return d.uid == request.auth.uid
        && d.keys().size() <= 20
        && d.estado == 'pendiente'
        && texto(d.nombre, 200) && texto(d.email, 200);
    }
    match /propuestas_hitos/{id} {
      allow create: if ingresado() && pedidoValido(request.resource.data)
        && texto(request.resource.data.titulo, 200) && texto(request.resource.data.descripcion, 4000);
      allow read, update, delete: if esAdmin();
    }
    match /solicitudes_acceso/{id} {
      allow create: if ingresado() && pedidoValido(request.resource.data)
        && texto(request.resource.data.material, 300) && texto(request.resource.data.uso, 4000);
      allow read, update, delete: if esAdmin();
    }
    match /propuestas_material/{id} {
      allow create: if ingresado() && pedidoValido(request.resource.data)
        && texto(request.resource.data.titulo, 300) && texto(request.resource.data.descripcion, 4000);
      allow read, update, delete: if esAdmin();
    }
  }
}
