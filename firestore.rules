rules_version = '2';

// Reglas de seguridad de Firestore para el calendario de JM Argentina.
// Copiá todo este archivo en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{db}/documents {

    function ingresado() { return request.auth != null; }
    function rolDoc() { return /databases/$(db)/documents/roles/$(request.auth.uid); }
    function tieneRol() { return ingresado() && exists(rolDoc()); }
    function esAdmin() { return tieneRol() && get(rolDoc()).data.rol == 'admin'; }
    function esJefe() { return tieneRol() && get(rolDoc()).data.rol in ['jefe', 'admin']; }

    function texto(v, max) { return v is string && v.size() <= max; }
    function eventoValido(d) {
      return d.keys().hasOnly(['titulo', 'fecha', 'fechaFin', 'hora', 'lugar', 'rama', 'tipo', 'descripcion',
                               'costo', 'link', 'info', 'thumb', 'tieneFlyer', 'autorUid', 'autorNombre',
                               'creado', 'actualizado'])
        && texto(d.titulo, 120) && d.titulo.size() > 0
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && texto(d.rama, 120)
        && d.tipo in ['Nacional', 'Regional', 'Rama']
        && texto(d.descripcion, 2000) && d.descripcion.size() > 0
        && (!('thumb' in d) || texto(d.thumb, 80000));
    }

    // Cualquiera que ingresó guarda su nombre y correo (así el admin puede habilitarlo como jefe).
    match /usuarios/{uid} {
      allow read: if esAdmin() || (ingresado() && request.auth.uid == uid);
      allow create, update: if ingresado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'foto', 'ultimoIngreso']);
      allow delete: if esAdmin();
    }

    // Roles: cada uno lee el suyo; solo un admin asigna o quita roles.
    // El primer admin se crea a mano desde la consola (ver FIREBASE.md).
    match /roles/{uid} {
      allow read: if esAdmin() || (ingresado() && request.auth.uid == uid);
      allow write: if esAdmin();
    }

    // Eventos: los ve todo el mundo. Publican jefes y admins; cada jefe edita o borra los suyos.
    match /eventos/{id} {
      allow read: if true;
      allow create: if esJefe()
        && request.resource.data.autorUid == request.auth.uid
        && eventoValido(request.resource.data);
      allow update: if (esAdmin() || (esJefe() && resource.data.autorUid == request.auth.uid))
        && request.resource.data.autorUid == resource.data.autorUid
        && eventoValido(request.resource.data);
      allow delete: if esAdmin() || (esJefe() && resource.data.autorUid == request.auth.uid);
    }

    // Flyers en tamaño completo (separados para que la lista de eventos cargue rápido).
    match /flyers/{id} {
      allow read: if true;
      allow create, update: if (esAdmin() || (esJefe() && getAfter(/databases/$(db)/documents/eventos/$(id)).data.autorUid == request.auth.uid))
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if esAdmin() || (esJefe() && get(/databases/$(db)/documents/eventos/$(id)).data.autorUid == request.auth.uid);
    }
  }
}
